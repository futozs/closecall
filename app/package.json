{
  "name": "closecall-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mock": "vite build --mode mock --outDir dist/mock",
    "preview": "vite preview",
    "preview:mock": "vite preview --outDir dist/mock --port 4173 --strictPort",
    "check": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "i18next": "27.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
