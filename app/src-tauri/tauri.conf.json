{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Close Call",
  "version": "0.1.0",
  "identifier": "hu.futozs.closecall",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Close Call",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Closes the sensitive tabs and documents you left open before anyone sees your screen.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "./dmg/background.tiff",
        "windowSize": { "width": 660, "height": 428 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      },
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./en.lproj/InfoPlist.strings",
        "Resources/hu.lproj/InfoPlist.strings": "./hu.lproj/InfoPlist.strings"
      }
    }
  }
}
