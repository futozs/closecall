{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo tree *)",
      "Bash(cargo deny *)",
      "Bash(cargo metadata *)",
      "Bash(bun install *)",
      "Bash(bun run *)",
      "Bash(bun x vitest *)",
      "Bash(bun x playwright *)",
      "Bash(bun x biome *)",
      "Bash(bun x tsc *)",
      "Bash(bunx vitest *)",
      "Bash(bunx playwright *)",
      "Bash(bunx biome *)",
      "Bash(bunx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Bash(cargo add *)",
      "Bash(cargo clean *)",
      "Bash(bun add *)",
      "Bash(git push *)",
      "Bash(tccutil *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(sudo rm *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh *)",
      "Bash(curl * | bash *)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.key)"
    ]
  }
}
